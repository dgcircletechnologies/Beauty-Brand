model ProductHairProfile {
  productId     String
  hairProfileId String

  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  hairProfile HairProfile @relation(fields: [hairProfileId], references: [id], onDelete: Restrict)

  // Same hair profile cannot be assigned twice to a product
  @@id([productId, hairProfileId])
  // Useful for filtering products by hair/scalp profile
  @@index([hairProfileId])
}
