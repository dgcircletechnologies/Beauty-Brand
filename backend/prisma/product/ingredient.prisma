model Ingredient {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  inciName    String?
  description String?
  benefits    String?
  warnings    String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products  ProductIngredient[]
  avoidedBy UserAvoidedIngredient[]

  @@index([name])
  @@index([isActive])
}
