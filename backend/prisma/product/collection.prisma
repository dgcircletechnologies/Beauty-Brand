model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products CollectionProduct[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([startsAt, endsAt])
}
