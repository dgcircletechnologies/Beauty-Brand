model ProductConcern {
  productId String
  concernId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  concern Concern @relation(fields: [concernId], references: [id], onDelete: Restrict)

  @@id([productId, concernId])
  @@index([concernId])
}
