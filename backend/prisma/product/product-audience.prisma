model ProductAudience {
  productId  String
  audienceId String

  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Restrict)

  // Same audience cannot be assigned twice to a product
  @@id([productId, audienceId])
  // Useful when searching products by audience
  @@index([audienceId])
}
