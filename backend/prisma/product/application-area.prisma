model ApplicationArea {
  id String @id @default(cuid())

  // Basic information
  name        String
  slug        String  @unique
  description String?

  // Controls display order in admin/storefront filters
  sortOrder Int @default(0)

  // Administration
  isActive Boolean @default(true)

  // Soft delete / archive
  deletedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products ProductApplicationArea[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}
