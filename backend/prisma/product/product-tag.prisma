model ProductTag {
  productId String
  tagId     String

  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  // Same tag cannot be assigned twice to a product
  @@id([productId, tagId])
  // Useful for filtering products by tag
  @@index([tagId])
}
