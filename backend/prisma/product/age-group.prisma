model AgeGroup {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  minAge      Int?
  maxAge      Int?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products           ProductAgeGroup[]
  preferenceProfiles UserPreferenceAgeGroup[]

  @@index([name])
  @@index([isActive])
}
