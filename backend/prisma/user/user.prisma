model User {
  id                     String     @id @default(cuid())
  firstName              String
  lastName               String?
  email                  String     @unique
  passwordHash           String?
  role                   UserRole   @default(CUSTOMER)
  status                 UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt        DateTime?
  marketingConsent       Boolean    @default(false)
  personalizationEnabled Boolean    @default(true)
  lastLoginAt            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  addresses               Address[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  carts                   Cart[]
  orders                  Order[]
  wishlist                Wishlist?
  reviews                 Review[]
  preferenceProfile       UserPreferenceProfile?
  notifications           Notification[]
  requestedCancellations  CancellationRequest[]    @relation("CancellationRequestedBy")
  decidedCancellations    CancellationRequest[]    @relation("CancellationDecidedBy")
  orderStatusChanges      OrderStatusHistory[]     @relation("OrderStatusChangedBy")
  inventoryMovements      InventoryMovement[]      @relation("InventoryMovementPerformedBy")
  auditLogs               AuditLog[]               @relation("AuditLogUser")

  @@index([status])
  @@index([role])
  @@index([deletedAt])
}
