model UserPreferenceProfile {
  id          String           @id @default(cuid())
  userId      String           @unique
  isEnabled   Boolean          @default(true)
  source      PreferenceSource @default(ACCOUNT)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinTypes          UserPreferenceSkinType[]
  concerns           UserPreferenceConcern[]
  ageGroups          UserPreferenceAgeGroup[]
  hairProfiles       UserPreferenceHairProfile[]
  audiences          UserPreferenceAudience[]
  avoidedIngredients UserAvoidedIngredient[]
}
