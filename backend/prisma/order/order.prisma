model Order {
  id                      String      @id @default(cuid())
  userId                  String
  orderNumber             String      @unique
  idempotencyKey          String      @unique
  status                  OrderStatus @default(PENDING_PAYMENT)
  baseCurrencyCode        String      @db.Char(3)
  displayCurrencyCode     String      @db.Char(3)
  exchangeRate            Decimal     @default(1) @db.Decimal(20, 8)
  exchangeRateEffectiveAt DateTime?
  subtotal                Decimal     @db.Decimal(12, 2)
  shippingAmount          Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount               Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount          Decimal     @default(0) @db.Decimal(12, 2)
  rewardSavings           Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  shippingRateId          String?
  shippingMethodName      String?
  shippingServiceCode     String?
  customerEmail           String
  customerPhone           String?
  placedAt                DateTime?
  paidAt                  DateTime?
  cancelledAt             DateTime?
  deliveredAt             DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  baseCurrency    Currency      @relation("OrderBaseCurrency", fields: [baseCurrencyCode], references: [code], onDelete: Restrict)
  displayCurrency Currency      @relation("OrderDisplayCurrency", fields: [displayCurrencyCode], references: [code], onDelete: Restrict)
  shippingRate    ShippingRate? @relation(fields: [shippingRateId], references: [id], onDelete: SetNull)

  items                OrderItem[]
  addresses            OrderAddressSnapshot[]
  payments             PaymentTransaction[]
  statusHistory        OrderStatusHistory[]
  shipments            Shipment[]
  cancellationRequests CancellationRequest[]
  notifications        Notification[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([shippingRateId])
}
