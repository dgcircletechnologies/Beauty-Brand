model StoreSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String?
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}
