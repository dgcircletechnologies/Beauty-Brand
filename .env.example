# Copy this file to .env for local Docker runs or configure the same names
# as GitHub Actions secrets for production deploys.

POSTGRES_USER=skincare
POSTGRES_PASSWORD=change_me
POSTGRES_DB=skincare_db
DATABASE_URL=postgresql://skincare:change_me@postgres:5432/skincare_db

# Host ports. The container ports stay stable internally.
# Local defaults from docker-compose.yml:
# POSTGRES_PORT=5432
# BACKEND_PORT=3000
# FRONTEND_PORT=5000
#
# Production defaults from docker-compose.prod.yml:
# POSTGRES_PORT=5433
# BACKEND_PORT=9000
# FRONTEND_PORT=5001
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=5000

CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
APP_FRONTEND_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_BASE_URL=http://backend:3000/api/v1

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
REFRESH_TOKEN_HASH_SECRET=
ONE_TIME_TOKEN_HASH_SECRET=
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=60

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=change_me
SMTP_FROM=
SUPPORT_EMAIL=

CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me
CLOUDINARY_PRODUCT_FOLDER=bluewave/products
CLOUDINARY_CATEGORY_FOLDER=bluewave/categories

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
